# Copy to .env next to docker-compose.yml and adjust.
APP_PORT=8484
DATA_PATH=./data
TZ=America/Edmonton

# First-run bootstrap login. On first sign-in Daybook forces a new
# username and password before the app can be used.
DAYBOOK_SETUP_USERNAME=admin
DAYBOOK_SETUP_PASSWORD=change-me-before-exposing
DAYBOOK_USER_NAME=Sara

# Encrypt the live SQLite database. Generate once with: openssl rand -hex 32
# Keep this key somewhere safe; losing it makes the database unrecoverable.
# DAYBOOK_DB_KEY=

# When behind Nginx Proxy Manager + Let's Encrypt:
# ORIGIN=https://daybook.example.com
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
