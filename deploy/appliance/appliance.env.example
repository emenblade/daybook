# Copy to appliance.env on the installer USB. Keep it private.
DAYBOOK_IMAGE=ghcr.io/emenblade/daybook:1.9.0
DAYBOOK_DOMAIN=daybook.herdomain.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token

# First-run bootstrap; Daybook forces a permanent login on first sign-in.
DAYBOOK_SETUP_USERNAME=admin
DAYBOOK_SETUP_PASSWORD=replace-with-a-random-bootstrap-password
DAYBOOK_USER_NAME=Sara
TZ=America/Edmonton

# Optional. If omitted, the installer generates these and prints them once.
# DAYBOOK_DB_KEY=
# BACKUP_PASSPHRASE=
