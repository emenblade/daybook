# Copy to .env next to docker-compose.yml and adjust.
APP_PORT=8484
DATA_PATH=./data
TZ=America/Edmonton

# First-run bootstrap login. On first sign-in Daybook forces a new
# username and password before the app can be used.
DAYBOOK_SETUP_USERNAME=admin
DAYBOOK_SETUP_PASSWORD=change-me-before-exposing
DAYBOOK_USER_NAME=Sara
